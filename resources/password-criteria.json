[
    { "key": "min_length", "label": "Mínimo 16 caracteres", "type": "match", "pattern": "^[\\s\\S]{16,}$" },
    { "key": "uppercase", "label": "Al menos una letra mayúscula (A-Z)", "type": "match", "pattern": "[A-Z]" },
    { "key": "lowercase", "label": "Al menos una letra minúscula (a-z)", "type": "match", "pattern": "[a-z]" },
    { "key": "digit", "label": "Al menos un número (0-9)", "type": "match", "pattern": "[0-9]" },
    { "key": "special", "label": "Al menos un carácter especial (!@#$%^&*)", "type": "match", "pattern": "[!@#$%^&*]" },
    { "key": "no_whitespace", "label": "Sin espacios en blanco", "type": "no_match", "pattern": "[\\s\\p{Z}]" },
    { "key": "no_triple_repeat", "label": "Sin tres o más caracteres iguales seguidos", "type": "no_match", "pattern": "([\\s\\S])\\1\\1" }
